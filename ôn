function rt(t, o = {}) {
  return t.split('**').map((s, i) => new TextRun({
    text: s, bold: (i % 2 === 1) || o.bold, size: o.size, color: o.color, italics: o.italics, font: FONT
  }));
}
function p(t, o = {}) {
  return new Paragraph({ children: rt(t, o), spacing: { after: o.after ?? 80, before: o.before ?? 0 }, alignment: o.align, keepNext: o.keepNext });
}
const h1 = (t) => new Paragraph({ heading: HeadingLevel.HEADING_1, children: [new TextRun({ text: t, font: FONT })], pageBreakBefore: false });
const h2 = (t) => new Paragraph({ heading: HeadingLevel.HEADING_2, children: [new TextRun({ text: t, font: FONT })] });
const h3 = (t) => new Paragraph({ heading: HeadingLevel.HEADING_3, children: [new TextRun({ text: t, font: FONT })] });
const bl = (t, lvl = 0) => new Paragraph({ numbering: { reference: 'b', level: lvl }, children: rt(t), spacing: { after: 50 } });
const pb = () => new Paragraph({ children: [new D.PageBreak()] });

const border = { style: BorderStyle.SINGLE, size: 4, color: "A6A6A6" };
const borders = { top: border, bottom: border, left: border, right: border };

function cell(t, w, o = {}) {
  const lines = String(t).split('\n');
  return new TableCell({
    width: { size: w, type: WidthType.DXA }, borders,
    shading: o.fill ? { fill: o.fill, type: ShadingType.CLEAR, color: "auto" } : undefined,
    margins: { top: 50, bottom: 50, left: 90, right: 90 },
    children: lines.map(l => new Paragraph({ children: rt(l, { size: 19, bold: o.bold }), spacing: { after: 20 } }))
  });
}
function tbl(headers, rows, widths) {
  const hdr = new TableRow({ tableHeader: true, children: headers.map((h, i) => cell(h, widths[i], { fill: "D9E2F3", bold: true })) });
  const body = rows.map(r => new TableRow({ cantSplit: true, children: r.map((c, i) => cell(c, widths[i], { fill: i === 0 ? "F2F2F2" : undefined })) }));
  return new Table({ width: { size: W, type: WidthType.DXA }, columnWidths: widths, rows: [hdr, ...body] });
}
function box(lines, fill = "FFF2CC") {
  return new Table({
    width: { size: W, type: WidthType.DXA }, columnWidths: [W],
    rows: [new TableRow({ children: [new TableCell({
      width: { size: W, type: WidthType.DXA }, borders,
      shading: { fill, type: ShadingType.CLEAR, color: "auto" },
      margins: { top: 80, bottom: 80, left: 140, right: 140 },
      children: lines.map(l => new Paragraph({ children: rt(l, { size: 20 }), spacing: { after: 40 } }))
